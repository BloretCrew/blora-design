{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
    "MD036": false,
    "MD040": false,
    "MD060": false,
    "MD032": false,
    "MD022": false,
    "MD034": false,
    "MD012": false,
    "MD029": false,
    "MD056": false,
  },
  "globs": ["**/*.md"],
