{
  "name": "thread",
  "category": "data-display",
  "status": "beta",
  "kind": "composite-custom-elements",
  "since": "2.0.0",
  "requiresJavaScript": true,
  "formAssociated": false,
  "customElements": {
    "blora-thread-comment": {
      "attributes": [
        "collapse-height",
        "label-expand",
        "label-collapse",
        "data-collapsible",
        "data-collapsed",
        "data-blora-ready"
      ],
      "properties": ["collapsible", "collapsed"],
      "methods": ["refresh", "expand", "collapse", "toggle"],
      "definitions": ["slot=head", "slot=quote", "default body", "slot=reactions"],
      "cssProperties": ["--blora-thread-collapse-height", "--blora-thread-content-height"]
    },
    "blora-thread-composer": {
      "attributes": ["tab", "edit-label", "preview-label", "data-tab", "data-blora-ready"],
      "properties": ["tab"],
      "methods": ["setTab"],
      "events": ["blora-thread-tab-change"],
      "definitions": ["slot=toolbar", "default editor", "slot=preview", "slot=actions"]
    }
  },
  "attributes": {
    "data-blora-thread-react": {
      "description": "Optional reaction toggle inside blora-thread-comment; toggles data-active and aria-pressed"
    },
    "data-active": {
      "description": "Controller-written active state for a reaction or generated composer tab"
    }
  },
  "properties": {},
  "methods": {},
  "events": {},
  "slots": {},
  "parts": [],
  "cssProperties": ["--blora-thread-collapse-height", "--blora-thread-content-height"],
  "classes": [
    ".blora-thread",
    ".blora-thread-comment",
    ".blora-thread-comment__card",
    ".blora-thread-comment__head",
    ".blora-thread-comment__meta",
    ".blora-thread-comment__actions",
    ".blora-thread-comment__quote",
    ".blora-thread-comment__body",
    ".blora-thread-comment__fold",
    ".blora-thread-comment__react",
    ".blora-thread-composer",
    ".blora-thread-composer__tabs",
    ".blora-thread-composer__toolbar",
    ".blora-thread-composer__input",
    ".blora-thread-composer__preview",
    ".blora-thread-composer__footer"
  ],
  "accessibilityPattern": "list",
  "migrationFromV1": "thread.migration.md"
}
