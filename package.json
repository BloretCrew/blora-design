{
  "name": "@bloret-crew/blora-design-monorepo",
  "version": "2.0.0-beta.0",
  "private": true,
  "description": "Blora Design 2.0 — token-driven, accessible Web UI design system (monorepo root)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "pnpm -r run lint",
    "lint:css": "pnpm -r run lint:css",
    "lint:contracts": "node packages/blora-design/scripts/check-contracts.mjs && pnpm --filter @bloret-crew/blora-tokens run check:contracts",
    "lint:contrast": "pnpm --filter @bloret-crew/blora-tokens run check:contrast",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:browser": "pnpm -r run test:browser",
    "test:a11y": "playwright test --project=a11y",
    "test:visual": "pnpm --filter @bloret-crew/blora-design run build && playwright test --project=visual --config playwright.config.ts",
    "build": "pnpm run build:tokens && pnpm -r run build",
    "build:tokens": "node packages/tokens/scripts/build-tokens.mjs",
    "pages": "node scripts/build-showcase-pages.mjs",
    "size": "pnpm -r run size",
    "pack:test": "pnpm -r run pack:test",
    "pack:test:addons": "node scripts/pack-test-addons.mjs",
    "publint": "publint packages/blora-design",
    "publint:addons": "node scripts/publint-addons.mjs",
    "attw": "attw --pack packages/blora-design --profile esm-only --exclude-entrypoints ./tokens.css ./tokens.dark.css ./tokens.themes.css ./reset.css ./foundations.css ./blora.css ./components/button.css ./components/dialog.css ./components/select.css ./components/field.css ./components/input.css ./components/textarea.css ./components/checkbox.css ./components/radio.css ./components/switch.css ./components/tag.css ./components/alert.css ./components/badge.css ./components/progress.css ./components/spinner.css ./components/skeleton.css ./components/tabs.css ./components/breadcrumb.css ./components/pagination.css ./components/dropdown.css ./components/tooltip.css ./components/popover.css ./components/drawer.css ./components/navbar.css ./components/sidebar-nav.css ./components/card.css ./components/table.css ./components/list.css ./components/accordion.css ./components/timeline.css ./components/empty.css ./components/result.css ./components/avatar.css ./components/banner.css ./components/message.css ./components/notification.css ./components/steps.css ./components/statistic.css ./components/descriptions.css ./components/image.css ./components/segmented.css ./components/popconfirm.css ./components/collapse.css ./components/autocomplete.css ./components/calendar.css ./components/carousel.css ./components/cascader.css ./components/chart-container.css ./components/chat.css ./components/color-picker.css ./components/command-palette.css ./components/comment.css ./components/copy.css ./components/datepicker.css ./components/deck.css ./components/dock.css ./components/fab.css ./components/masonry.css ./components/megamenu.css ./components/mentions.css ./components/mockup.css ./components/otp.css ./components/range.css ./components/rate.css ./components/search.css ./components/slider.css ./components/speed-dial.css ./components/splitter.css ./components/tags-input.css ./components/timepicker.css ./components/tour.css ./components/transfer.css ./components/tree.css ./components/tree-select.css ./components/upload.css ./components/backtop.css ./components/number-input.css ./components/swap.css ./components/media.css ./components/fieldset.css ./components/filter.css ./components/divider.css ./components/footer.css ./components/hero.css ./components/indicator.css ./components/join.css ./components/menu.css ./blora.global.js ./icons-full.global.js ./custom-elements.json ./component-manifest.json ./api-snapshot.json ./button ./select ./dialog ./table",
    "verify": "pnpm run build:tokens && pnpm run lint && pnpm run lint:css && pnpm run lint:contracts && pnpm run lint:contrast && pnpm run lint:md && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run publint && pnpm run publint:addons && pnpm run attw && pnpm run test:browser && pnpm run size && pnpm run pack:test && pnpm run pack:test:addons",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.10.1",
    "@changesets/cli": "^2.27.12",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.18.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "markdownlint-cli2": "^0.23.2",
    "playwright": "^1.49.1",
    "prettier": "^3.4.2",
    "publint": "^0.3.22",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
