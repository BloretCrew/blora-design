    "address": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "label": {
      "type": "string"
    }
  },
  "properties": {},
  "methods": {},
  "events": {},
  "slots": {
    "default": "Content consumed into the official variant-specific mockup frame. Code variants accept declarative <blora-mockup-line prefix tone> definitions."
  },
  "parts": [],
  "cssProperties": [
    "--blora-phone-max",
    "--blora-phone-radius",
    "--blora-phone-radius-se",
    "--blora-phone-rim",
    "--blora-phone-screen-radius",
    "--blora-phone-screen-radius-se",
    "--blora-phone-island-radius"
  ],
  "accessibilityPattern": "section"
}
