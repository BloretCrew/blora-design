{
  "$schema": "../../schemas/component-contract.schema.json",
  "name": "mockup",
  "category": "mockup",
  "status": "beta",
  "kind": "custom-element",
  "tagName": "blora-mockup",
  "since": "2.0.0",
  "requiresJavaScript": true,
  "formAssociated": false,
  "attributes": {
    "variant": {
      "type": "\"browser\" | \"code\" | \"window\" | \"phone\"",
      "default": "browser"
