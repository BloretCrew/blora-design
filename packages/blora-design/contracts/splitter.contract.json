{
  "$schema": "../../schemas/component-contract.schema.json",
  "name": "splitter",
  "category": "layout",
  "status": "beta",
  "kind": "custom-element",
  "tagName": "blora-splitter",
  "since": "2.0.0",
  "requiresJavaScript": true,
  "formAssociated": false,
  "attributes": {
    "position": {
      "type": "number",
      "default": 50
    },
    "min": {
      "type": "number",
      "default": 50
    }
  },
  "properties": {
    "position": {
      "type": "number"
    }
  },
  "methods": {
    "setPosition": {
      "signature": "(percent: number) => void"
    }
  },
  "events": {
    "blora-splitter-change": {
      "detail": "{ position: number }",
      "bubbles": true,
      "composed": false
    }
  },
  "slots": {
    "default": "Exactly two declarative <blora-splitter-pane> definitions; consumed into the official splitter tree."
  },
  "parts": [],
  "cssProperties": [],
  "accessibilityPattern": "separator"
}
