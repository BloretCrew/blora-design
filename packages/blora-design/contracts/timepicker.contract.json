      "default": "HH:MM"
    },
    "name": {
      "type": "string"
    },
    "step": {
      "type": "number"
    },
    "disabled": {
      "type": "boolean",
      "default": false
    },
    "required": {
      "type": "boolean",
      "default": false
    }
  },
  "properties": {
    "value": {
      "type": "string"
    }
  },
