{
  "name": "progress",
  "category": "feedback",
  "status": "stable",
  "kind": "custom-element",
  "tagName": "blora-progress",
  "since": "2.0.0",
  "requiresJavaScript": true,
  "formAssociated": false,
  "attributes": {
