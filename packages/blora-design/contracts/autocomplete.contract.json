{
  "$schema": "../../schemas/component-contract.schema.json",
  "name": "autocomplete",
  "category": "data-input",
  "status": "beta",
  "kind": "custom-element",
  "tagName": "blora-autocomplete",
  "since": "2.0.0",
  "requiresJavaScript": true,
  "formAssociated": false,
  "attributes": {
    "options": {
      "type": "string",
      "description": "JSON string array; declarative options are preferred."
    },
    "label": {
      "type": "string"
    },
    "placeholder": {
      "type": "string"
    },
    "value": {
      "type": "string",
      "default": ""
    },
    "disabled": {
      "type": "boolean",
      "default": false
    }
  },
  "properties": {
    "value": {
      "type": "string"
    }
  },
  "methods": {},
  "events": {
    "blora-autocomplete-change": {
      "detail": "{ value: string }",
      "bubbles": true,
      "composed": false
    }
  },
  "slots": {
    "default": "Declarative <blora-autocomplete-option value label disabled> definitions; consumed into the official autocomplete tree."
  },
  "parts": [],
  "cssProperties": [],
  "accessibilityPattern": "combobox",
  "migrationFromV1": "autocomplete.migration.md"
}
