{
  "$schema": "../../schemas/component-contract.schema.json",
  "name": "megamenu",
  "category": "navigation",
  "status": "beta",
  "kind": "custom-element",
  "tagName": "blora-megamenu",
  "since": "2.0.0",
  "requiresJavaScript": true,
  "formAssociated": false,
  "attributes": {
    "label": {
      "type": "string",
      "default": "浏览产品"
    },
    "open": {
      "type": "boolean",
      "default": false
    }
  },
  "properties": {},
  "methods": {
    "open": {
      "signature": "() => void"
    },
    "close": {
      "signature": "() => void"
    }
  },
  "events": {
    "blora-megamenu-toggle": {
      "detail": "{ open: boolean }",
      "bubbles": true,
      "composed": false
    }
  },
  "slots": {
    "default": "Declarative <blora-megamenu-section title> definitions containing links; consumed into the official menu grid."
  },
  "parts": [],
  "cssProperties": [
    "--blora-megamenu-offset"
  ],
  "accessibilityPattern": "menu",
  "migrationFromV1": "megamenu.migration.md"
}
