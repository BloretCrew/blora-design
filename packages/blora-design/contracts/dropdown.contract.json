{
  "$schema": "../../schemas/component-contract.schema.json",
  "name": "dropdown",
  "category": "actions",
  "status": "stable",
  "kind": "custom-element",
  "tagName": "blora-dropdown",
  "since": "2.0.0",
  "requiresJavaScript": true,
  "formAssociated": false,
  "attributes": {
    "label": {
      "type": "string"
    },
    "open": {
      "type": "boolean",
      "default": false
    },
    "disabled": {
      "type": "boolean",
      "default": false
    },
    "align": {
      "type": "\"start\" | \"center\" | \"end\"",
      "default": "start"
    },
    "placement": {
      "type": "\"bottom\" | \"top\"",
      "default": "bottom"
    },
    "variant": {
      "type": "\"menu\" | \"helper\"",
      "default": "menu"
    }
  },
  "properties": {},
  "methods": {
    "open": {
      "signature": "() => void"
    },
    "close": {
      "signature": "() => void"
    },
    "toggle": {
      "signature": "() => void"
    }
  },
  "events": {
    "blora-select": {
      "detail": "{ value: string }",
      "bubbles": true,
      "composed": true
    }
  },
  "controller": {
    "name": "createDropdownController",
    "description": "Optional headless controller that handles toggle, outside-click close, Escape close, item-click close, and ARIA synchronization. CSS-only base works without it.",
    "parameters": [
      {
        "name": "root",
        "type": "HTMLElement"
      }
    ],
    "returns": "DropdownController",
    "methods": {
      "open": {
        "returns": "void"
      },
      "close": {
        "returns": "void"
      },
      "toggle": {
        "returns": "void"
      },
      "destroy": {
        "returns": "void"
      }
    }
  },
  "slots": {
    "default": "Menu items (blora-dropdown-item) or arbitrary panel content such as a card",
    "trigger": "One consumer-owned trigger element, such as a button or profile summary"
  },
  "parts": [],
  "cssProperties": [],
  "accessibilityPattern": "navigation"
}
