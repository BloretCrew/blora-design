{
  "name": "tree-select",
  "category": "data-input",
  "status": "beta",
  "kind": "custom-element",
  "tagName": "blora-tree-select",
  "since": "2.0.0",
  "requiresJavaScript": true,
  "formAssociated": false,
  "attributes": {
    "options": {
      "type": "string",
      "description": "JSON tree options; declarative definitions are preferred."
    },
    "label": {
      "type": "string"
    },
    "placeholder": {
      "type": "string"
    },
    "value": {
      "type": "string",
      "default": ""
    },
    "disabled": {
      "type": "boolean",
      "default": false
    }
  },
  "properties": {
    "value": {
      "type": "string"
    }
  },
  "methods": {
    "open": {
      "signature": "() => void"
    },
    "close": {
      "signature": "() => void"
    }
  },
  "events": {
    "blora-treeselect-change": {
      "detail": "{ value, label, item }"
    }
  },
  "slots": {
    "default": "Nested declarative <blora-tree-select-option value label disabled selectable> definitions; consumed into the official combobox tree."
  },
  "parts": [],
  "cssProperties": [],
  "accessibilityPattern": "combobox"
}
