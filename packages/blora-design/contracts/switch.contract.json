{
  "name": "switch",
  "category": "data-input",
  "status": "stable",
  "kind": "custom-element",
  "tagName": "blora-switch",
  "since": "2.0.0",
  "requiresJavaScript": true,
  "formAssociated": true,
  "attributes": {
    "name": {
      "type": "string"
    },
    "value": {
      "type": "string",
      "default": "on"
    },
    "checked": {
      "type": "boolean",
      "default": false
    },
    "disabled": {
      "type": "boolean",
      "default": false
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "label": {
      "type": "string"
    },
    "size": {
      "type": "\"sm\" | \"lg\""
    }
  },
  "properties": {
    "checked": {
      "type": "boolean"
    },
    "value": {
      "type": "string"
    }
  },
  "methods": {
    "focus": {
      "signature": "(options?: FocusOptions) => void"
    }
  },
  "events": {
    "change": {
      "detail": "Event",
      "bubbles": true,
      "composed": false
    }
  },
  "slots": {
    "default": "Fallback label text, consumed next to the native checkbox."
  },
  "parts": [],
  "cssProperties": [
    "--blora-switch-w",
    "--blora-switch-h",
    "--blora-switch-pad",
    "--blora-switch-knob",
    "--blora-button-bg",
    "--blora-button-fg",
    "--blora-button-bd"
  ],
  "accessibilityPattern": "input"
}
