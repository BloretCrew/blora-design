{
  "$schema": "../../schemas/component-contract.schema.json",
  "name": "tour",
  "category": "navigation",
  "status": "beta",
  "kind": "custom-element",
  "tagName": "blora-tour",
  "since": "2.0.0",
  "requiresJavaScript": true,
  "formAssociated": false,
  "attributes": {
    "label": {
      "type": "string",
      "default": "开始漫游"
    },
    "open": {
      "type": "boolean",
      "default": false
    }
  },
  "properties": {},
  "methods": {
    "start": {
      "signature": "() => void"
    },
    "end": {
      "signature": "() => void"
    },
    "next": {
      "signature": "() => void"
    },
    "prev": {
      "signature": "() => void"
    }
  },
  "events": {
    "blora-tour-change": {
      "detail": "{ index: number, total: number }",
      "bubbles": true,
      "composed": false
    },
    "blora-tour-end": {
      "detail": "void",
      "bubbles": true,
      "composed": false
    }
  },
  "slots": {
    "default": "Declarative <blora-tour-step title description> definitions wrapping highlighted content; consumed into the official tour tree."
  },
  "parts": [],
  "cssProperties": [
    "--blora-tour-pad"
  ],
  "accessibilityPattern": "dialog",
  "migrationFromV1": "tour.migration.md"
}
