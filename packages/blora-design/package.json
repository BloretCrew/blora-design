{
  "name": "@bloret-crew/blora-design",
  "version": "2.0.0-alpha.0",
  "description": "Token-driven, accessible, zero-dependency Web UI design system.",
  "license": "Apache-2.0",
  "type": "module",
  "author": "RhedarLiu <rhedarliu@outlook.com>",
  "homepage": "https://github.com/BloretCrew/blora-design#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BloretCrew/blora-design.git",
    "directory": "packages/blora-design"
  },
  "bugs": {
    "url": "https://github.com/BloretCrew/blora-design/issues"
  },
  "sideEffects": [
    "./dist/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.dark.css": "./dist/tokens.dark.css",
    "./tokens.themes.css": "./dist/tokens.themes.css",
    "./reset.css": "./dist/reset.css",
    "./foundations.css": "./dist/foundations.css",
    "./blora.css": "./dist/blora.css",
    "./components/button.css": "./dist/components/button/button.css",
    "./components/dialog.css": "./dist/components/dialog/dialog.css",
    "./components/select.css": "./dist/components/select/select.css",
    "./token-manifest.json": "./dist/token-manifest.json",
    "./package.json": "./package.json",
    "./components/field.css": "./dist/components/field/field.css",
    "./components/input.css": "./dist/components/input/input.css",
    "./components/textarea.css": "./dist/components/textarea/textarea.css",
    "./components/checkbox.css": "./dist/components/checkbox/checkbox.css",
    "./components/radio.css": "./dist/components/radio/radio.css",
    "./components/switch.css": "./dist/components/switch/switch.css",
    "./components/tag.css": "./dist/components/tag/tag.css",
    "./components/alert.css": "./dist/components/alert/alert.css",
    "./components/badge.css": "./dist/components/badge/badge.css",
    "./components/progress.css": "./dist/components/progress/progress.css",
    "./components/spinner.css": "./dist/components/spinner/spinner.css",
    "./components/skeleton.css": "./dist/components/skeleton/skeleton.css",
    "./components/toast.css": "./dist/components/toast/toast.css",
    "./components/tabs.css": "./dist/components/tabs/tabs.css",
    "./components/breadcrumb.css": "./dist/components/breadcrumb/breadcrumb.css",
    "./components/pagination.css": "./dist/components/pagination/pagination.css",
    "./components/dropdown.css": "./dist/components/dropdown/dropdown.css",
    "./components/tooltip.css": "./dist/components/tooltip/tooltip.css",
    "./components/popover.css": "./dist/components/popover/popover.css",
    "./components/drawer.css": "./dist/components/drawer/drawer.css",
    "./components/navbar.css": "./dist/components/navbar/navbar.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "contracts/",
    "schemas/",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint src/ tests/",
    "lint:css": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run --config vitest.config.ts",
    "test:browser": "pnpm run build && playwright test --config ../../playwright.config.ts",
    "build": "node ../tokens/scripts/build-tokens.mjs && vite build && tsc --emitDeclarationOnly && node scripts/copy-tokens.mjs",
    "build:tokens": "node ../tokens/scripts/build-tokens.mjs",
    "size": "node scripts/check-size.mjs",
    "pack:test": "node scripts/pack-test.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@bloret-crew/blora-design": "workspace:*"
  }
}
