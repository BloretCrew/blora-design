{
  "$description": "Primitive dimension values from Blora Design 1.x (spacing, radius, control metrics, range).",
  "space": {
    "0": { "$type": "dimension", "$value": "0" },
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.5rem" },
    "6": { "$type": "dimension", "$value": "2rem" },
    "7": { "$type": "dimension", "$value": "2.5rem" },
    "8": { "$type": "dimension", "$value": "3rem" },
    "9": { "$type": "dimension", "$value": "4rem" },
    "10": { "$type": "dimension", "$value": "5rem" },
    "11": { "$type": "dimension", "$value": "6rem" },
    "12": { "$type": "dimension", "$value": "8rem" }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "6px" },
    "sm": { "$type": "dimension", "$value": "10px" },
    "md": { "$type": "dimension", "$value": "14px" },
    "lg": { "$type": "dimension", "$value": "18px" },
    "xl": { "$type": "dimension", "$value": "26px" },
    "2xl": { "$type": "dimension", "$value": "36px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "primitive": {
    "control": {
      "height": { "$type": "dimension", "$value": "2.75em" },
      "padX": { "$type": "dimension", "$value": "1em" },
      "radius": { "$type": "dimension", "$value": "{radius.full}" }
    },
    "range": {
      "trackSize": { "$type": "dimension", "$value": "4px" },
      "thumbSize": { "$type": "dimension", "$value": "18px" }
    }
  }
}
