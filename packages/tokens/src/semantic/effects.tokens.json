{
  "$description": "Semantic focus and accent shadows derived from the primary action color.",
  "shadow": {
    "primary": {
      "$type": "shadow",
      "$value": "0 0 0 1px color-mix(in srgb, {color.action.primary.default} 18%, transparent), 0 2px 6px color-mix(in srgb, {color.action.primary.default} 15%, transparent)"
    }
  },
  "focusRing": {
    "width": {
      "$type": "dimension",
      "$value": "2px"
    },
    "widthStrong": {
      "$type": "dimension",
      "$value": "3px"
    },
    "offset": {
      "$type": "dimension",
      "$value": "2px"
    },
    "default": {
      "$type": "shadow",
      "$value": "0 0 0 3px color-mix(in srgb, {color.action.primary.default} 12%, transparent)"
    },
    "strong": {
      "$type": "shadow",
      "$value": "0 0 0 3px color-mix(in srgb, {color.action.primary.default} 18%, transparent)"
    }
  }
}
